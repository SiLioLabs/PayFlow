{
  "name": "payflow-scripts",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "vitest --run --config vitest.config.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "build": "tsc --project tsconfig.json",
    "alerts:validate": "promtool check rules alerts.yml"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  "type": "module",
  "description": "Operational and analytics scripts for FlowPay",
  "scripts": {
    "test": "vitest run",
    "test:merchant": "vitest run __tests__/merchant-queries.test.ts __tests__/merchant-analytics.test.ts",
    "test:event-dedup": "tsx test-event-dedup-integration.ts",
    "test:renewal-forecast": "tsx test-renewal-forecast.ts",
    "test:rpc-failover": "tsx test-rpc-failover.ts",
    "test:audit-trail-reconcile": "tsx test-audit-trail-reconcile.ts",
    "test:allowance-utils": "tsx test-allowance-utils.ts",
    "typecheck": "tsc --noEmit --module esnext --moduleResolution bundler",
    "typecheck:esm": "tsc --noEmit --module esnext --moduleResolution bundler",
    "lint": "tsc --noEmit --strict --noUnusedLocals --noUnusedParameters",
    "lint:duplicates": "tsx lint-duplicates.ts",
    "build": "tsc -p tsconfig.build.json",
    "indexer": "NODE_OPTIONS='--experimental-sqlite --unhandled-rejections=throw' tsx indexer.ts",
    "query-events": "NODE_OPTIONS='--experimental-sqlite --unhandled-rejections=throw' tsx query-events.ts",
    "api": "NODE_OPTIONS='--experimental-sqlite --unhandled-rejections=throw' tsx indexer-api.ts",
    "api:openapi": "NODE_OPTIONS='--experimental-sqlite' tsx indexer-api.ts --openapi > ../docs/openapi/indexer-api.json",
    "backfill-gaps": "NODE_OPTIONS='--experimental-sqlite --unhandled-rejections=throw' tsx horizon-backfill.ts",
    "keeper": "tsx keeper.ts",
    "watch-events": "tsx watch-events.ts",
    "check-allowances": "tsx check-allowances.ts",
    "alert-expiring-allowances": "tsx alert-expiring-allowances.ts",
    "batch-optimizer": "tsx batch-optimizer.ts",
    "pre-upgrade-check": "tsx pre-upgrade-check.ts",
    "subscriber-health": "tsx subscriber-health-dashboard.ts",
    "topup-allowance": "tsx topup-allowance.ts",
    "validate-config": "tsx validate-config.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.0.0",
    "prom-client": "^15.1.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
