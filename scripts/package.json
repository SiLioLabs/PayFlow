{
  "name": "payflow-scripts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Operational and analytics scripts for FlowPay",
  "engines": {
    "node": ">=22.5.0",
    "npm": ">=10"
  },
  "scripts": {
    "preinstall": "node check-node-version.cjs",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:merchant": "vitest run __tests__/merchant-queries.test.ts __tests__/merchant-analytics.test.ts",
    "typecheck": "tsc --noEmit --module esnext --moduleResolution bundler",
    "typecheck:esm": "tsc --noEmit --module esnext --moduleResolution bundler",
    "lint": "tsc --noEmit --strict --noUnusedLocals --noUnusedParameters",
    "lint:duplicates": "tsx lint-duplicates.ts",
    "check:root-hygiene": "bash check-root-hygiene.sh",
    "build": "tsc -p tsconfig.build.json",
    "indexer": "NODE_OPTIONS='--experimental-sqlite --unhandled-rejections=throw' tsx indexer.ts",
    "query-events": "NODE_OPTIONS='--experimental-sqlite --unhandled-rejections=throw' tsx query-events.ts",
    "keeper": "tsx keeper.ts",
    "watch-events": "tsx watch-events.ts",
    "check-allowances": "tsx check-allowances.ts",
    "alert-expiring-allowances": "tsx alert-expiring-allowances.ts",
    "batch-optimizer": "tsx batch-optimizer.ts",
    "pre-upgrade-check": "tsx pre-upgrade-check.ts",
    "subscriber-health": "tsx subscriber-health-dashboard.ts",
    "topup-allowance": "tsx topup-allowance.ts",
    "validate-config": "tsx validate-config.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.0.0",
    "prom-client": "^15.1.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^2.1.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
