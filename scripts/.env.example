# PayFlow Keeper — environment configuration
# Copy to scripts/.env and fill in your values before running docker compose.

# ── Contract ──────────────────────────────────────────────────────────────────

# Deployed Soroban contract ID (C...)
CONTRACT_ID=

# Stellar RPC endpoint
# Testnet: https://soroban-testnet.stellar.org
# Mainnet: https://soroban-mainnet.stellar.org  (or your own node)
RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase
# Testnet: "Test SDF Network ; September 2015"
# Mainnet: "Public Global Stellar Network ; September 2015"
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Signing key ───────────────────────────────────────────────────────────────
# Use KEEPER_SECRET_FILE for production / mainnet (Docker secrets, tmpfs).
# KEEPER_SECRET / SECRET_KEY are accepted for testnet convenience but will
# print a warning if used on mainnet.

# Path to a file containing the keeper signing secret (recommended)
KEEPER_SECRET_FILE=

# Or supply the secret directly (not recommended for mainnet)
KEEPER_SECRET=

# Legacy fallback — same warning as KEEPER_SECRET
# SECRET_KEY=

# ── Fee-bump (optional) ───────────────────────────────────────────────────────
# Set both variables to enable fee-bump envelopes.

# Public key of the fee-bump source account
FEE_BUMP_SOURCE=

# File path for fee-bump account secret (recommended)
FEE_BUMP_SECRET_FILE=

# Or env var (not recommended for mainnet)
FEE_BUMP_SECRET=

# ── Adaptive fees ─────────────────────────────────────────────────────────────

# Multiplier applied to simulated resource fee (default: 1.2 = 20% headroom)
FEE_MULTIPLIER=1.2

# Hard ceiling for the resource fee in stroops. Transactions above this limit
# are skipped and pushed to the DLQ. Default: 100_000_000 (10 XLM)
FEE_CEILING_STROOPS=100000000

# ── Keeper behaviour ──────────────────────────────────────────────────────────

# Number of subscriber addresses per batch_charge call
BATCH_SIZE=50

# Milliseconds between keeper cycles
POLL_INTERVAL_MS=60000

# ── Metrics ───────────────────────────────────────────────────────────────────

# Port for the Prometheus /metrics endpoint
METRICS_PORT=9091
