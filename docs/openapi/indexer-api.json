{
  "openapi": "3.0.3",
  "info": {
    "title": "FlowPay Indexer API",
    "version": "1.0.0",
    "description": "Read-only HTTP API over the FlowPay event indexer database. All amounts are stroop strings."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness and database availability.",
        "responses": {
          "200": {
            "description": "Database reachable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/merchants/{address}/churn": {
      "get": {
        "summary": "Subscriber churn and growth for a merchant over a window.",
        "parameters": [
          {
            "name": "address",
            "in": "path",
            "required": true,
            "description": "Merchant address.",
            "schema": {
              "type": "string",
              "pattern": "^[GC][A-Z2-7]{55}$"
            }
          },
          {
            "name": "days",
            "in": "query",
            "description": "Comparison window in days.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365,
              "default": 30
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Churn"
                }
              }
            }
          },
          "400": {
            "description": "Invalid path or query parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/merchants/{address}/events": {
      "get": {
        "summary": "Events involving a merchant, newest first.",
        "parameters": [
          {
            "name": "address",
            "in": "path",
            "required": true,
            "description": "Merchant address.",
            "schema": {
              "type": "string",
              "pattern": "^[GC][A-Z2-7]{55}$"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Rows to skip.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "event_name",
            "in": "query",
            "description": "Only return events with this name (e.g. charged).",
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid path or query parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/merchants/{address}/revenue": {
      "get": {
        "summary": "Net revenue (charges minus protocol fees) for a merchant.",
        "parameters": [
          {
            "name": "address",
            "in": "path",
            "required": true,
            "description": "Merchant address.",
            "schema": {
              "type": "string",
              "pattern": "^[GC][A-Z2-7]{55}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Revenue"
                }
              }
            }
          },
          "400": {
            "description": "Invalid path or query parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/users/{address}/events": {
      "get": {
        "summary": "Events for a subscriber/actor address, newest first.",
        "parameters": [
          {
            "name": "address",
            "in": "path",
            "required": true,
            "description": "Subscriber (user) address.",
            "schema": {
              "type": "string",
              "pattern": "^[GC][A-Z2-7]{55}$"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Rows to skip.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "event_name",
            "in": "query",
            "description": "Only return events with this name (e.g. charged).",
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid path or query parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "event_name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "merchant": {
            "type": "string",
            "nullable": true
          },
          "amount": {
            "type": "string",
            "nullable": true
          },
          "fee_amount": {
            "type": "string",
            "nullable": true
          },
          "token": {
            "type": "string",
            "nullable": true
          },
          "result_code": {
            "type": "string",
            "nullable": true
          },
          "ledger": {
            "type": "integer"
          },
          "timestamp": {
            "type": "integer"
          },
          "tx_hash": {
            "type": "string"
          },
          "data": {
            "description": "Decoded event value (JSON), or null.",
            "nullable": true
          }
        }
      },
      "EventPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "pagination": {
            "type": "object",
            "properties": {
              "limit": {
                "type": "integer"
              },
              "offset": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              },
              "has_more": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "Revenue": {
        "type": "object",
        "properties": {
          "merchant": {
            "type": "string"
          },
          "total_net_revenue": {
            "type": "string"
          },
          "subscriber_count": {
            "type": "integer"
          },
          "daily_revenue_last_30_days": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string"
                },
                "net_revenue": {
                  "type": "string"
                }
              }
            }
          },
          "freshness": {
            "type": "object",
            "properties": {
              "last_ledger": {
                "type": "integer",
                "nullable": true
              },
              "is_fresh": {
                "type": "boolean"
              },
              "staleness_seconds": {
                "type": "number",
                "nullable": true
              }
            }
          }
        }
      },
      "Churn": {
        "type": "object",
        "properties": {
          "merchant": {
            "type": "string"
          },
          "window_days": {
            "type": "integer"
          },
          "found": {
            "type": "boolean"
          },
          "subscriber_count": {
            "type": "integer"
          },
          "churn_rate_percent": {
            "type": "number",
            "nullable": true
          },
          "growth_rate_percent": {
            "type": "number",
            "nullable": true
          },
          "revenue_in_window": {
            "type": "string"
          },
          "is_new": {
            "type": "boolean",
            "nullable": true
          },
          "freshness": {
            "type": "object",
            "properties": {
              "last_ledger": {
                "type": "integer",
                "nullable": true
              },
              "is_fresh": {
                "type": "boolean"
              },
              "staleness_seconds": {
                "type": "number",
                "nullable": true
              }
            }
          }
        }
      }
    }
  }
}
