# Keeper secret key (required). You can generate one with `stellar-sdk Keypair.random()`.
KEEPER_SECRET=

# Optional public key. If set, the keeper will verify it matches KEEPER_SECRET.
KEEPER_PUBLIC_KEY=

# Network passphrase. Defaults to the Stellar mainnet.
# For mainnet, set to: "Public Global Stellar Network ; September 2015"
NETWORK_PASSTHRASE=

# Must be "true" when using the mainnet passphrase.
ALLOW_MAINNET=false

# Indexer backfill mode: optional start and end ledger for controlled backfill.
# If unset, the indexer resumes from the last checkpoint.
BACKFILL_START_LEDGER=
BACKFILL_END_LEDGER=

# Backfill rate limit (requests per second). Defaults to a safe value compatible with RPC.
BACKFILL_RATE_LIMIT=

# Path to the checkpoint file for progressive backfill checkpoints.
BACKFILL_CHECKPOINT_FILE=
