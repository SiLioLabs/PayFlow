# Stellar Contract ID
# Copy this from your deployed contract after running `soroban contract deploy`.
# It must be a valid 56-character C-prefixed Soroban contract ID (e.g., C...).
VITE_CONTRACT_ID=

# Soroban RPC URL
# If not set, defaults to https://soroban-testnet.stellar.org
VITE_RPC_URL=

# Stellar Network Passphrase
# Set this to configure which network the frontend connects to.
# The connected wallet's network must match this passphrase for mutations to be allowed.
# Available values: "Test SDF Network ; September 2015" (testnet), "Public Global Stellar Network ; September 2015" (mainnet)
# If not set, defaults to testnet
VITE_NETWORK_PASSPHRASE=

# Error reporting endpoint (optional — disabled by default)
# Set to a URL that accepts POST requests with a JSON ErrorReport body to enable
# the pluggable error reporter in ErrorBoundary. When unset, caught errors are
# only logged to the browser console in development mode and are never sent
# anywhere.
#
# PRIVACY: before the report is sent, every Stellar public key (G…), contract
# ID (C…), and secret key (S…) in the error message and component stack is
# replaced with [redacted]. No wallet addresses or keys leave the browser.
# See docs/DEPLOYMENT.md for the full opt-in details and payload schema.
#
# VITE_ERROR_REPORT_URL=https://errors.example.com/report
VITE_ERROR_REPORT_URL=
