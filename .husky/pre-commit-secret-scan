#!/usr/bin/env sh
# Secret scanning pre-commit hook using gitleaks
# Prevents committing secrets to the repository

echo "🔍 Scanning for secrets with gitleaks..."

# Check if gitleaks is installed
if ! command -v gitleaks &> /dev/null; then
    echo "⚠️  gitleaks is not installed. Skipping secret scan."
    echo "   Install with: brew install gitleaks (macOS) or see https://github.com/gitleaks/gitleaks"
    echo "   This check will be enforced in CI."
    exit 0
fi

# Run gitleaks on staged files
if gitleaks protect --staged --config .gitleaks.toml --verbose --redact; then
    echo "✅ No secrets detected"
    exit 0
else
    echo ""
    echo "❌ SECRET DETECTED! Commit blocked."
    echo ""
    echo "Gitleaks found potential secrets in your staged changes."
    echo "Please remove any sensitive data before committing."
    echo ""
    echo "Common issues:"
    echo "  • Stellar secret keys (S...)"
    echo "  • API keys or tokens"
    echo "  • Private keys or certificates"
    echo ""
    echo "If this is a false positive, you can:"
    echo "  1. Add an allowlist entry to .gitleaks.toml"
    echo "  2. Use gitleaks:allow comment in the file"
    echo ""
    exit 1
fi
